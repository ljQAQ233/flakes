{
    "clangd.path": "clangd",
    "git.enableGutters": true,
    "inlayHint.display": false,
    "inlayHint.enable": true,
    "inlayHint.enableParameter": true,
    "inlayHint.refreshOnInsertMode": true,
    "links.highlight": true,
    "Lua.workspace.library": [
        "~/.local/share/nvim/site/pack/packer/start/"
    ],
    "semanticTokens.enable": true,
    "suggest.autoTrigger": "always",
    "suggest.completionItemKindLabels": {
        "class": "",
        "color": "",
        "constant": "",
        "constructor": "",
        "default": " ",
        "enum": "",
        "enumMember": "",
        "event": "",
        "field": "",
        "file": "",
        "folder": "",
        "function": "ƒ",
        "interface": "",
        "keyword": "",
        "method": "",
        "module": "",
        "operator": "Ψ",
        "property": "",
        "reference": "渚",
        "snippet": "",
        "struct": "פּ",
        "text": "",
        "typeParameter": "",
        "unit": "",
        "value": "",
        "variable": "v"
    },
    "suggest.detailField": "preview",
    "suggest.enableFloat": true,
    "suggest.noselect": false,
    "sumneko-lua.customPath": "/etc/profiles/per-user/maouai233/bin/lua-language-server",
    "sumneko-lua.enable": true,
    "sumneko-lua.enableNvimLuaDev": true,
    "translator.engines": [
        "youdao"
    ],
    "translator.toLang": "zh_CN",
}
