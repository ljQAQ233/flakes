{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    /* for the definition of XDG_CONFIG_HOME, SEE https://specifications.freedesktop.org/basedir/latest/ */
    /* inspirations of using orange logo firstly came from https://www.bilibili.com/video/BV1LUnZztE1G */
    "source": "${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/logo.png",
    "height": 16,
    "padding": {
      "top": 5,
    },
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors",
    {
      "type": "command",
      "key": "OS Age",
      "text": "birth=$(stat -c %W /); current=$(date +%s); echo $(( (current - birth) / 86400 )) days",
    },
  ],
}
